# Copie para .env (que fica fora do git) e preencha.
# Gere o valor com:  python cli.py segredo
# O MESMO valor vai nas Variables do teu servico no Railway.
ARGOS_SECRET=

# Fase 4 - IA local (opcional). So aceita endereco local/rede privada.
OLLAMA_URL=http://localhost:11434
ARGOS_MODELO=
# (vazio = usa o melhor modelo que estiver instalado no teu Ollama)

# v2.2 - settings de PRODUCAO do Django pro `check --deploy` (opcional).
# Vazio = usa o settings de dev e nao trava o selo por DEBUG/HSTS/cookies.
# Ex.: core.settings.prod
ARGOS_DJANGO_SETTINGS=
